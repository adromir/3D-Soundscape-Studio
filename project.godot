; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="3D Soundscape Studio"
run/main_scene="res://src/ui/main_view.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.045, 0.052, 0.065, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
config/icon="res://icon.svg"

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="ignore"
window/per_pixel_transparency/allowed=true
window/size/min_width=1280
window/size/min_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/copy_all_errors/plugin.cfg", "res://addons/godot-copy-all-errors-main/addons/copy_all_errors/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
